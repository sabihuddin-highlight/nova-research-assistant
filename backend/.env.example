# Google AI Studio API key — used by all four agents for LLM reasoning.
# Get one free (no credit card) at https://aistudio.google.com → Get API key.
GOOGLE_API_KEY=

# Tavily API key — used by the Research Agent for web search.
# Get one free at https://app.tavily.com (1000 free searches/month).
TAVILY_API_KEY=

# Model selection. Default is Gemini 2.5 Flash (fast, generous free tier).
LLM_MODEL=gemini-2.5-flash

# Server
HOST=127.0.0.1
PORT=8000

# CORS — comma-separated origins that may call this API.
ALLOWED_ORIGINS=http://localhost:3000
